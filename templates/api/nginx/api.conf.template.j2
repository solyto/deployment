proxy_cache_path /var/cache/nginx/favicons levels=1:2 keys_zone=favicon_cache:10m max_size=500m inactive=60d use_temp_path=off;
limit_req_zone $binary_remote_addr zone=favicon_req:10m rate=20r/s;
map $fav_letter $fav_letter_uc {
    default $fav_letter;
    a A; b B; c C; d D; e E; f F; g G; h H; i I; j J; k K; l L; m M;
    n N; o O; p P; q Q; r R; s S; t T; u U; v V; w W; x X; y Y; z Z;
}

server {
    listen {{ api_listen_port }};
    server_name {{ api_nginx_urls }};

    root /var/www/public;
    index index.php index.html;

    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    fastcgi_hide_header X-Powered-By;

    client_max_body_size 50M;

    error_page 413 @error_413;
    error_page 502 @error_502;
    error_page 503 @error_503;
    error_page 504 @error_504;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json text/plain text/css application/javascript;

    # Website icons, fetched from DuckDuckGo once and cached here so browsers never contact it directly
    location ~ "^/favicons/(?<fav_host>(?<fav_letter>[a-z0-9])[a-z0-9-]*(\.[a-z0-9-]+)+)\.ico$" {
        limit_req zone=favicon_req burst=200 nodelay;

        resolver 127.0.0.11 valid=300s ipv6=off;
        proxy_pass https://icons.duckduckgo.com/ip3/$fav_host.ico;
        proxy_ssl_server_name on;
        proxy_pass_request_headers off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;

        proxy_cache favicon_cache;
        proxy_cache_key $fav_host;
        proxy_cache_valid 200 404 30d;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;

        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Set-Cookie;
        expires 7d;
        access_log off;

        proxy_intercept_errors on;
        error_page 404 =200 @favicon_placeholder;
    }

    # Shown for sites DuckDuckGo has no icon for: the first letter of the domain in a light grey circle (c-neutral-1, c-neutral-5)
    location @favicon_placeholder {
        types { }
        default_type image/svg+xml;
        expires 7d;
        access_log off;
        return 200 '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#f3f4f6"/><text x="12" y="16.5" fill="#6a7282" font-family="system-ui, sans-serif" font-size="13" font-weight="600" text-anchor="middle">$fav_letter_uc</text></svg>';
    }

    location ^~ /storage/ {
        alias /var/www/storage/app/public/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;

        location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|pdf|doc|docx|zip)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    location / {
        fastcgi_param REQUEST_METHOD $request_method;

        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass {{ api_php_container }}:{{ php_fpm_port }};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # nginx's own error responses carry CORS headers so the frontend can read the status code
    location @error_413 {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 413 '{"message":"Payload too large"}';
    }

    location @error_502 {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 502 '{"message":"Bad gateway"}';
    }

    location @error_503 {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 503 '{"message":"Service unavailable"}';
    }

    location @error_504 {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 504 '{"message":"Gateway timeout"}';
    }
}

server {
    listen {{ dav_listen_port }};
    server_name {{ dav_nginx_urls }};

    root /var/www/public;

    client_max_body_size 50M;

    location / {
        include fastcgi_params;
        fastcgi_pass {{ api_dav_container }}:{{ php_fpm_port }};
        fastcgi_index dav.php;
        fastcgi_param SCRIPT_FILENAME $document_root/dav.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_buffering off;
        fastcgi_request_buffering off;
    }
}
